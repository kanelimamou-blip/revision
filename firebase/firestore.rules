rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function validCode(code) {
      let p = code.split('-');
      return p.size() == 2 && p[0].size() == 5
        && hashing.sha256('__SEL_CODES__' + p[0]).toHexString().lower()[0:6] == p[1].lower();
    }
    // propriétaire de l'appli : seul ce compte Google ouvre l'espace admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'kanelimamou@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // mode parent répétiteur : le parent relié par l'enfant (champ « parents » écrit par l'enfant lui-même)
    function isParentOf(uid) {
      return request.auth != null && request.auth.uid in get(/databases/$(db)/documents/users/$(uid)).data.get('parents', []);
    }
    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin()
        || (request.auth != null && request.auth.uid in resource.data.get('parents', []));
      // l'admin ne peut changer que la suspension et le premium (paiement validé)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suspended', 'premium', 'premiumAt'])
        && request.resource.data.get('suspended', false) is bool
        && request.resource.data.premium is bool;
      // création : date fixée par le serveur et sans premium
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.created == request.time
        && request.resource.data.premium == false
        && !('suspended' in request.resource.data);
      // la date de création ne change jamais ; le premium ne s'obtient qu'avec un code réclamé par cet élève
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.created == resource.data.created
        && request.resource.data.get('suspended', false) == resource.data.get('suspended', false)
        && (request.resource.data.premium == resource.data.premium
          || (request.resource.data.premium == true
            && getAfter(/databases/$(db)/documents/claims/$(request.resource.data.code)).data.uid == uid));
    }
    // enfants qui révisent sur le téléphone du parent : une fiche de progrès par enfant, dans le compte du parent
    match /users/{uid}/enfants/{eid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && eid.size() <= 20
        && request.resource.data.keys().hasOnly(['data', 'level', 'nom', 'at'])
        && request.resource.data.at == request.time;
    }
    // code de liaison parent → enfant (8 caractères) : le parent le crée, l'enfant l'accepte une seule fois depuis son compte
    match /liens/{code} {
      allow get: if request.auth != null && code.size() == 8;
      allow list: if isAdmin();
      allow delete: if isAdmin() || (request.auth != null && resource.data.parent == request.auth.uid);
      allow create: if request.auth != null && code.size() == 8
        && request.resource.data.keys().hasOnly(['parent', 'pnom', 'at'])
        && request.resource.data.parent == request.auth.uid
        && request.resource.data.pnom is string && request.resource.data.pnom.size() <= 60
        && request.resource.data.at == request.time;
      allow update: if request.auth != null && !('enfant' in resource.data)
        && resource.data.parent != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enfant', 'enom', 'level', 'okAt'])
        && request.resource.data.enfant == request.auth.uid
        && request.resource.data.enom is string && request.resource.data.enom.size() <= 60
        && request.resource.data.level is string && request.resource.data.level.size() <= 30
        && request.resource.data.okAt == request.time;
    }
    // missions et séances données par le parent à un enfant qui a son propre compte ; l'enfant les coche
    match /missions/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin() || isParentOf(uid);
      allow create, update: if ((request.auth != null && request.auth.uid == uid) || isParentOf(uid))
        && request.resource.data.keys().hasOnly(['items', 'seances', 'pnom', 'at'])
        && request.resource.data.get('items', []) is list && request.resource.data.get('items', []).size() <= 60
        && request.resource.data.get('seances', []) is list && request.resource.data.get('seances', []).size() <= 120
        && request.resource.data.at == request.time;
      allow delete: if isAdmin();
    }
    // suivi spécifique demandé par un parent : l'équipe répond par des conseils, le parent les lit
    match /suivis/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.parent == request.auth.uid);
      allow delete: if isAdmin() || (request.auth != null && resource.data.parent == request.auth.uid);
      allow create: if request.auth != null && id.matches(request.auth.uid + '_[a-z0-9]{1,20}')
        && request.resource.data.parent == request.auth.uid
        && request.resource.data.keys().hasOnly(['parent', 'pnom', 'tel', 'enfant', 'level', 'objectif', 'matieres', 'dispo', 'resume', 'statut', 'conseils', 'at'])
        && request.resource.data.statut == 'attente' && request.resource.data.conseils == []
        && request.resource.data.objectif is string && request.resource.data.objectif.size() <= 600
        && request.resource.data.get('resume', '') is string && request.resource.data.get('resume', '').size() <= 3000
        && request.resource.data.at == request.time;
      allow update: if request.auth != null && resource.data.parent == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['objectif', 'matieres', 'dispo', 'resume', 'level', 'tel', 'maj'])
        && request.resource.data.objectif is string && request.resource.data.objectif.size() <= 600
        && request.resource.data.get('resume', '') is string && request.resource.data.get('resume', '').size() <= 3000
        && request.resource.data.maj == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['conseils', 'statut'])
        && request.resource.data.statut in ['attente', 'en_cours', 'termine'];
    }
    // sessions de groupe : chaque élève connecté écrit seulement sa propre note, le groupe lit le classement
    match /sessions/{code}/scores/{uid} {
      allow read: if request.auth != null && code.size() <= 12;
      allow create, update: if request.auth != null && request.auth.uid == uid && code.size() <= 12
        && request.resource.data.keys().hasOnly(['name', 'note', 'score', 'total', 'level', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.note is number && request.resource.data.note >= 0 && request.resource.data.note <= 20
        && request.resource.data.score is int && request.resource.data.total is int
        && request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.total && request.resource.data.total <= 50
        && request.resource.data.level is string && request.resource.data.level.size() <= 20
        && request.resource.data.at == request.time;
      allow delete: if false;
    }
    // téléphones : un seul essai gratuit par téléphone ; chaque compte ne peut que s'ajouter à la liste
    match /devices/{id} {
      allow get: if request.auth != null && id.size() == 20;
      allow list: if isAdmin();
      allow create: if request.auth != null && id.size() == 20
        && request.resource.data.keys().hasOnly(['first', 'uids'])
        && request.resource.data.first == request.time
        && request.resource.data.uids == [request.auth.uid];
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['first', 'uids'])
        && request.resource.data.first == resource.data.first
        && !(request.auth.uid in resource.data.uids)
        && request.resource.data.uids.hasAll(resource.data.uids)
        && request.resource.data.uids.hasAll([request.auth.uid])
        && request.resource.data.uids.size() == resource.data.uids.size() + 1
        && request.resource.data.uids.size() <= 50;
      allow delete: if false;
    }
    // journal des erreurs : chaque client connecté ou non peut signaler une erreur, seul l'admin la lit
    match /errors/{id} {
      allow read, delete: if isAdmin();
      allow update: if false;
      allow create: if request.resource.data.keys().hasOnly(['uid', 'email', 'page', 'msg', 'ua', 'level', 'at'])
        && request.resource.data.uid == (request.auth != null ? request.auth.uid : null)
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 500
        && request.resource.data.page is string && request.resource.data.page.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 100
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 200
        && request.resource.data.level is string && request.resource.data.level.size() <= 20
        && request.resource.data.at == request.time;
    }
    // paiement déclaré dans l'appli : l'élève envoie sa capture, seul l'admin valide ou refuse
    match /paiements/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow list, delete: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && (resource == null || resource.data.statut != 'valide')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'phone', 'level', 'via', 'img', 'statut', 'at', 'formule', 'montant', 'enfants'])
        && request.resource.data.get('formule', 'eleve') in ['eleve', 'parent', 'suivi']
        && request.resource.data.get('montant', 0) is int && request.resource.data.get('montant', 0) <= 200000
        && request.resource.data.get('enfants', 0) is int && request.resource.data.get('enfants', 0) <= 10
        && request.resource.data.uid == uid
        && request.resource.data.statut == 'attente'
        && request.resource.data.img is string && request.resource.data.img.size() <= 450000
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.level is string && request.resource.data.level.size() <= 30
        && request.resource.data.via in ['wave', 'om']
        && request.resource.data.at == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'motif', 'fin'])
        && request.resource.data.statut in ['valide', 'refuse'];
    }
    // registre des ventes : réservé à l'admin
    match /ventes/{id} {
      allow read, write: if isAdmin();
    }
    // fiche société (mentions légales, reçus) : lisible par tous, modifiable par l'admin seul
    match /config/{id} {
      allow get: if true;
      allow list, write: if isAdmin();
    }
    // accord du parent avant l'abonnement : l'élève crée la demande, le parent (sans compte) l'accepte une fois, l'admin lit la trace
    match /accords/{token} {
      allow get: if token.size() >= 20;
      allow list, delete: if isAdmin();
      allow create: if request.auth != null && token.size() >= 20 && token.size() <= 40
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'eleve', 'tel', 'level', 'statut', 'v', 'at', 'naissance'])
        && request.resource.data.statut in ['attente', 'majeur']
        && request.resource.data.at == request.time
        && request.resource.data.eleve is string && request.resource.data.eleve.size() <= 60
        && request.resource.data.tel is string && request.resource.data.tel.size() <= 20
        && request.resource.data.level is string && request.resource.data.level.size() <= 30
        && request.resource.data.v is string && request.resource.data.v.size() <= 20
        && request.resource.data.get('naissance', '') is string && request.resource.data.get('naissance', '').size() <= 10;
      allow update: if resource.data.statut == 'attente'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'parent', 'ptel', 'lien', 'okAt'])
        && request.resource.data.statut == 'ok'
        && request.resource.data.okAt == request.time
        && request.resource.data.parent is string && request.resource.data.parent.size() >= 2 && request.resource.data.parent.size() <= 60
        && request.resource.data.ptel is string && request.resource.data.ptel.size() <= 20
        && request.resource.data.lien in ['pere', 'mere', 'tuteur'];
    }
    // un code ne peut être réclamé qu'une fois (pas de recréation possible)
    match /claims/{code} {
      allow read, update, delete: if false;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && validCode(code);
    }
  }
}
